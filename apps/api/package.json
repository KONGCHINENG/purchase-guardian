{
  "name": "@guardian/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.12",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@guardian/paypal-client": "*",
    "@guardian/policy-engine": "*",
    "@guardian/shared": "*",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
