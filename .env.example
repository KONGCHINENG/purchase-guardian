# ─── API (apps/api/.env) ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Local: embedded Postgres (no install). Production: postgres://user:pass@host:5432/db
DATABASE_URL=pglite://./.data/pglite
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
WEB_URL=http://localhost:3000

# AI. Priority: NVIDIA → Anthropic → offline heuristic parser (which can never auto-approve).
# NVIDIA NIM key from https://build.nvidia.com (OpenAI-compatible API); also powers the shopping agent.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# PayPal: "mock" for offline dev; "sandbox" with credentials from developer.paypal.com
PAYPAL_ENV=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required to accept webhooks in sandbox/live (Dashboard → your app → Webhooks)
PAYPAL_WEBHOOK_ID=

APPROVAL_TTL_MINUTES=60
CHECKOUT_SESSION_TTL_MINUTES=30
DEMO_STORE_ENABLED=true

# Web Push for phone approvals. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Web (apps/web/.env) ─────────────────────────────────────────────
# Where the Next.js server proxies /api/v1/* (server-side only)
API_URL=http://localhost:4000
